{"repo": {"timestamp": 1793910766000, "version": 20002, "name": "Bitwarden Patched", "icon": "icon.png", "address": "https://mkalmousli.github.io/BitwardenPatched/repo", "description": "Patched builds of the open-source Bitwarden Android app (unofficial fork, not affiliated with Bitwarden Inc.)."}, "requests": {"install": [], "uninstall": []}, "apps": [{"authorName": "mkalmousli", "authorWebSite": "https://github.com/mkalmousli", "categories": ["Security", "Sync"], "changelog": "https://github.com/mkalmousli/BitwardenPatched/releases", "suggestedVersionCode": "14", "description": "Unofficial, automatically rebuilt version of the open-source Bitwarden Android app,\npublished shortly after every upstream release. Client-side premium features such as\nbuilt-in TOTP are switched on. Installs next to the official app. Not affiliated with\nBitwarden Inc.\nThis is a patch layer, not an independent password manager.\nSource and patch list: https://github.com/mkalmousli/BitwardenPatched\nUpstream: https://github.com/bitwarden/android", "issueTracker": "https://github.com/mkalmousli/BitwardenPatched/issues", "license": "GPL-3.0-only", "name": "Bitwarden Patched", "sourceCode": "https://github.com/mkalmousli/BitwardenPatched", "summary": "Unofficial, auto-updated build of the open-source Bitwarden password manager", "webSite": "https://mkalmousli.github.io/BitwardenPatched/", "added": 1793313683000, "packageName": "com.x8bit.bitwarden.patched", "lastUpdated": 1793910764000, "localized": {"en-US": {"description": "Bitwarden Patched is an unofficial patch layer, automatically rebuilt from the source of the open-source Bitwarden Android app. A new build appears here shortly after every upstream Bitwarden release, so the app stays current without any manual work.\n\n<b>What you get</b>\n\u2022 The Bitwarden vault, autofill, passkeys and sync you already know\n\u2022 Client-side premium features such as built-in TOTP codes switched on\n\u2022 One small APK per CPU type (arm64-v8a, armeabi-v7a, x86, x86_64)\n\u2022 Its own app id (com.x8bit.bitwarden.patched), so it installs next to the official app\n\u2022 The original logo with a fork badge, so you can tell them apart\n\u2022 Works with Bitwarden cloud or a self-hosted Bitwarden or Vaultwarden server\n\n<b>Trust</b>\n\u2022 Built in public by GitHub Actions from the upstream source plus a short, published list of patches\n\u2022 Stable signing key; every release ships SHA-256 checksums and the patched source code\n\u2022 Encryption, networking and sync code are not modified. Anything the server enforces still follows your plan\n\nNot affiliated with or endorsed by Bitwarden Inc. \"Bitwarden\" is a trademark of its owner. Licensed GPL-3.0.\n\n<b>Source and patch details</b>\n<a href=\"https://github.com/mkalmousli/BitwardenPatched\">Patch repository and complete patch list</a>\n<a href=\"https://github.com/bitwarden/android\">Original Bitwarden Android source</a>\n\nThe first screenshot explains this patch. The following screenshots are original Bitwarden Android store images from the archived bitwarden/mobile repository; they illustrate upstream features and may differ from current builds.\n", "featureGraphic": "featureGraphic_YdgaxdQvU-eyWLgbl2rLahkQU791tqjk-aue3ovONn0=.png", "icon": "icon_YutZZ_oTSpY_GXJok6AL9aXQWvqlVT3fcrbpn8Mjk7g=.png", "name": "Bitwarden Patched", "phoneScreenshots": ["1.png", "2.png", "3.png", "4.png"], "summary": "Unofficial, auto-updated build of the open-source Bitwarden password manager"}}}], "packages": {"com.x8bit.bitwarden.patched": [{"added": 1793313683000, "apkName": "bitwarden-patched-android-v2026.10.1-bwpm-arm64-v8a.apk", "hash": "9932a69922ec675b3fadff93988320def32431c783aabd80ee078aa7c64502aa", "hashType": "sha256", "minSdkVersion": 29, "nativecode": ["arm64-v8a"], "packageName": "com.x8bit.bitwarden.patched", "sig": "c70217cbe9700a1605db8ce8c0c1094c", "signer": "b1d78fec2a8513efd0ef78ae2c73887dfdc84f4ce6c786c61d524e1d4b43821b", "size": 59808908, "targetS