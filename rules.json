{
  "android": {
    "repo": "bitwarden/android",
    "tag": "-bwpm$",
    "rules": [
      {
        "anchor": "isPremium = profile.hasPremiumPersonally",
        "find": "isPremium = profile\\.hasPremiumPersonally == true \\|\\|\\s*profile\\.hasPremiumFromOrganization == true,",
        "with": "isPremium = true,"
      }
    ],
    "build": [["./gradlew", "app:assembleFdroidDebug", "-q"]],
    "artifacts": "app/build/outputs/apk/**/*.apk"
  },
  "browser": {
    "repo": "bitwarden/clients",
    "tag": "^browser-v",
    "rules": [
      {
        "anchor": "hasPremiumFromAnyOrganization === true ||",
        "find": "profile\\?\\.hasPremiumFromAnyOrganization === true \\|\\|\\s*profile\\?\\.hasPremiumPersonally === true",
        "with": "true"
      },
      {
        "anchor": "!!profile?.hasPremiumPersonally",
        "find": "!!profile\\?\\.hasPremiumPersonally",
        "with": "true"
      }
    ],
    "build": [["npm", "ci"], ["npm", "run", "dist:chrome", "--prefix", "apps/browser"], ["npm", "run", "dist:firefox", "--prefix", "apps/browser"]],
    "artifacts": "apps/browser/dist/*.zip"
  }
}
